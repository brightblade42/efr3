# Example configuration for the phase-1 prerequisite workflow.
# Copy this file to `eyefr.env` and adjust values as needed.
#
# Example:
#   cp eyefr.env.example eyefr.env

# Service account to create/manage for EyeFR.
USER_NAME=eyemetric
GROUP_NAME=eyemetric

# Whether to install and configure NVIDIA support when a GPU is present.
# 1 = enabled, 0 = disabled
SETUP_NVIDIA=1

# Whether to install Podman.
# 1 = enabled, 0 = disabled
SETUP_PODMAN=1

# Whether to install Distrobox.
# 1 = enabled, 0 = disabled
SETUP_DISTROBOX=1

# Whether to create/manage the service user.
# 1 = enabled, 0 = disabled
SETUP_USER=1

# Whether to enable package repositories required for prereqs.
# 1 = enabled, 0 = disabled
SETUP_REPOS=1

# Whether to update the system before installing prereqs.
# 1 = enabled, 0 = disabled
UPDATE_SYSTEM=1


# NVIDIA container toolkit repo channel.
# Usually leave this alone.
NVIDIA_TOOLKIT_CHANNEL=stable

# If set to 1, grant passwordless sudo to the wheel group.
# This writes /etc/sudoers.d/wheel-nopass
ENABLE_WHEEL_NOPASSWD=1

# Where to install the `just` binary when bootstrapping a new machine.
JUST_INSTALL_DIR=/usr/local/bin

# Pin the `just` version for reproducible installs. Use `latest` to follow newest releases.
JUST_VERSION=1.48.1

# RHEL-family major version used for NVIDIA and repo URLs.
OS_MAJOR_VERSION=9
