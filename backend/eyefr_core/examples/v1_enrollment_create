#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/_common"

EXT_ID="${1:-1001}"

jq -n --arg ext "$EXT_ID" '{
  command: "enroll",
  candidates: [{ ccode: $ext }]
}' | curl -H "Content-Type: application/json" \
     -X POST "http://localhost:3000/fr/enrollment/create" \
     -d @-
